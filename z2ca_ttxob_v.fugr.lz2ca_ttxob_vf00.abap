*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: Z2CA_TTXOB_V....................................*
FORM GET_DATA_Z2CA_TTXOB_V.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM Z2CA_TTXOB WHERE
(VIM_WHERETAB) .
    CLEAR Z2CA_TTXOB_V .
Z2CA_TTXOB_V-MANDT =
Z2CA_TTXOB-MANDT .
Z2CA_TTXOB_V-TDOBJECT =
Z2CA_TTXOB-TDOBJECT .
    SELECT SINGLE * FROM TTXOB WHERE
TDOBJECT = Z2CA_TTXOB-TDOBJECT .
    IF SY-SUBRC EQ 0.
      SELECT SINGLE * FROM TTXOT WHERE
TDOBJECT = TTXOB-TDOBJECT AND
TDSPRAS = SY-LANGU .
      IF SY-SUBRC EQ 0.
Z2CA_TTXOB_V-TDTEXT =
TTXOT-TDTEXT .
      ENDIF.
    ENDIF.
<VIM_TOTAL_STRUC> = Z2CA_TTXOB_V.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_Z2CA_TTXOB_V .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO Z2CA_TTXOB_V.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_Z2CA_TTXOB_V-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM Z2CA_TTXOB WHERE
  TDOBJECT = Z2CA_TTXOB_V-TDOBJECT .
    IF SY-SUBRC = 0.
    DELETE Z2CA_TTXOB .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM Z2CA_TTXOB WHERE
  TDOBJECT = Z2CA_TTXOB_V-TDOBJECT .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR Z2CA_TTXOB.
    ENDIF.
Z2CA_TTXOB-MANDT =
Z2CA_TTXOB_V-MANDT .
Z2CA_TTXOB-TDOBJECT =
Z2CA_TTXOB_V-TDOBJECT .
    IF SY-SUBRC = 0.
    UPDATE Z2CA_TTXOB ##WARN_OK.
    ELSE.
    INSERT Z2CA_TTXOB .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_Z2CA_TTXOB_V-UPD_FLAG,
STATUS_Z2CA_TTXOB_V-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_Z2CA_TTXOB_V.
  SELECT SINGLE * FROM Z2CA_TTXOB WHERE
TDOBJECT = Z2CA_TTXOB_V-TDOBJECT .
Z2CA_TTXOB_V-MANDT =
Z2CA_TTXOB-MANDT .
Z2CA_TTXOB_V-TDOBJECT =
Z2CA_TTXOB-TDOBJECT .
    SELECT SINGLE * FROM TTXOB WHERE
TDOBJECT = Z2CA_TTXOB-TDOBJECT .
    IF SY-SUBRC EQ 0.
      SELECT SINGLE * FROM TTXOT WHERE
TDOBJECT = TTXOB-TDOBJECT AND
TDSPRAS = SY-LANGU .
      IF SY-SUBRC EQ 0.
Z2CA_TTXOB_V-TDTEXT =
TTXOT-TDTEXT .
      ELSE.
        CLEAR SY-SUBRC.
        CLEAR Z2CA_TTXOB_V-TDTEXT .
      ENDIF.
    ELSE.
      CLEAR SY-SUBRC.
      CLEAR Z2CA_TTXOB_V-TDTEXT .
    ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_Z2CA_TTXOB_V USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE Z2CA_TTXOB_V-TDOBJECT TO
Z2CA_TTXOB-TDOBJECT .
MOVE Z2CA_TTXOB_V-MANDT TO
Z2CA_TTXOB-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'Z2CA_TTXOB'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN Z2CA_TTXOB TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'Z2CA_TTXOB'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
